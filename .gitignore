# ==========================================
# AeroMobility Git Ignore Rules
# ==========================================

# Environment & Secrets (Local only, never commit)
.env
.env.*
*.env
!.env.example
!**/.env.example

# Node & Frontend Build
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.vite/
**/.vite/
.cache/
coverage/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
vite.config.js.timestamp*
*.timestamp-*.mjs

# Python Virtual Environments & Bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
**/venv/
env/
**/env/
ENV/

# Large Datasets & Local Database Files
backend/data/*.csv
*.csv
*.sqlite
*.sqlite3
*.db

# Logs & Temporary Files
*.zip
*.log
*.tmp
*.temp
tmp/

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini